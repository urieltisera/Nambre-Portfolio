APP_NAME=Nambre
ENVIRONMENT=production
APP_TIMEZONE=America/Argentina/Buenos_Aires

# Contabo production keeps PostgreSQL in Docker. compose.production.yaml builds
# DATABASE_URL internally from these variables; do not commit real values.
POSTGRES_USER=<postgres-user>
POSTGRES_PASSWORD=<postgres-password>
POSTGRES_DB=<postgres-database>

# Generate a long random value for production. Never reuse this placeholder.
SECRET_KEY=<generate-a-long-random-secret>

ACCESS_TOKEN_MINUTES=480
MAX_PDF_BYTES=10485760
MAX_PRODUCT_IMAGE_BYTES=10485760
MAX_PRODUCT_IMAGE_SOURCE_DIMENSION=8000
PRODUCT_IMAGE_MAX_DIMENSION=1200
STORAGE_PATH=/data/storage

# Public browser/frontend URL.
FRONTEND_BASE_URL=https://nambre.com.ar
SITE_URL=https://nambre.com.ar
NEXT_PUBLIC_SITE_URL=https://nambre.com.ar
NEXT_PUBLIC_ACCESS_REQUEST_URL=

# Public URL used by backend-generated absolute links such as QR redirects.
PUBLIC_BASE_URL=https://nambre.com.ar

# Internal Docker route used by Next.js rewrites to reach the backend service.
API_PROXY_TARGET=http://backend:8000

# Production CORS should name public browser origins explicitly.
CORS_ORIGINS=https://nambre.com.ar
CORS_ORIGIN_REGEX=

SCAN_EVENT_RETENTION_DAYS=90
AUDIT_EVENT_RETENTION_DAYS=365
LOGIN_RATE_LIMIT_PER_MINUTE=5
PASSWORD_RESET_RATE_LIMIT_PER_HOUR=3
PASSWORD_RESET_TOKEN_MINUTES=30
INVITATION_TOKEN_HOURS=48

# SMTP is required for real password reset and invitation delivery.
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_USERNAME=<smtp-username>
SMTP_PASSWORD=<smtp-password>
SMTP_FROM_EMAIL=<no-reply@nambre.com.ar>
SMTP_FROM_NAME=Nambre
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
