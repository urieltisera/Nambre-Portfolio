APP_NAME=Nambre
ENVIRONMENT=local
APP_TIMEZONE=America/Argentina/Buenos_Aires
DATABASE_URL=postgresql+psycopg://menuflow:menuflow@localhost:5432/menuflow
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=480
MAX_PDF_BYTES=10485760
STORAGE_PATH=storage
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000
SCAN_EVENT_RETENTION_DAYS=90
AUDIT_EVENT_RETENTION_DAYS=365
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|10(?:\.\d{1,3}){3}|192\.168(?:\.\d{1,3}){2}|172\.(?:1[6-9]|2\d|3[0-1])(?:\.\d{1,3}){2})(?::\d+)?$
LOGIN_RATE_LIMIT_PER_MINUTE=5
PASSWORD_RESET_RATE_LIMIT_PER_HOUR=3
PASSWORD_RESET_TOKEN_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Nambre
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
API_PROXY_TARGET=http://backend:8000
NEXT_PUBLIC_ACCESS_REQUEST_URL=
POSTGRES_DB=menuflow
POSTGRES_USER=menuflow
POSTGRES_PASSWORD=menuflow
MINIO_ROOT_USER=menuflow
MINIO_ROOT_PASSWORD=menuflow-local-password
